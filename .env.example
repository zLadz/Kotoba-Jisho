# Banco de dados PostgreSQL (Docker Compose)
POSTGRES_DB=kotoba
POSTGRES_USER=kotoba
POSTGRES_PASSWORD=kotoba_dev_password
POSTGRES_PORT=5432

# String de conexão usada pela aplicação (Drizzle ORM)
DATABASE_URL=postgresql://kotoba:kotoba_dev_password@localhost:5432/kotoba

# API REST (Fastify)
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
CORS_ORIGIN=true