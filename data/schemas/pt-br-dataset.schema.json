{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kotoba.local/schemas/pt-br-dataset.schema.json",
  "title": "Kotoba PT-BR canonical translation dataset",
  "description": "Contrato canônico de troca da camada lexical pt-BR do Kotoba. O JMdict é a autoridade estrutural japonesa (kanji, readings, POS, prioridades); este schema governa apenas o dataset de traduções, consumido por um único importer, tanto para dados manuais quanto para dados gerados por IA.",
  "type": "object",
  "additionalProperties": false,
  "required": ["translations"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "translations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/translation"
      }
    }
  },
  "$defs": {
    "translation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jmdictSeq",
        "sensePosition",
        "language",
        "text",
        "source",
        "sourceVersion",
        "position"
      ],
      "properties": {
        "jmdictSeq": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "description": "jmdict_seq da entrada JMdict referenciada"
        },
        "sensePosition": {
          "type": "integer",
          "minimum": 0,
          "description": "position (0-based) da acepção dentro da entrada JMdict"
        },
        "language": {
          "type": "string",
          "minLength": 2,
          "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})?$",
          "description": "código do idioma da tradução (pt-BR para o dataset atual)"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "sourceVersion": {
          "type": "string",
          "minLength": 1
        },
        "position": {
          "type": "integer",
          "minimum": 0,
          "description": "ordem da tradução dentro da acepção (0-based)"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "confiança da tradução, quando disponível"
        }
      }
    }
  }
}
