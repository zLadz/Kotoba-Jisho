{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pt-br.schema.json",
  "title": "PT-BR Translation Entry (LadJisho)",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "meta", "translations"],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "../../../schemas/pt-br.schema.json"
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["experiment", "generatedAt", "unit", "source", "sourceVersion", "count", "excluded"],
      "properties": {
        "experiment": { "type": "string", "minLength": 1 },
        "generatedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "unit": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "sourceVersion": { "type": "string", "minLength": 1 },
        "count": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of translation items; must equal the length of the translations array."
        },
        "excluded": {
          "type": "object",
          "additionalProperties": false,
          "required": ["revise", "rejected"],
          "properties": {
            "revise": { "type": "integer", "minimum": 0 },
            "rejected": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "translations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/translation" }
    }
  },
  "$defs": {
    "translation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jmdictSeq", "kanji", "readings", "sense", "text", "status", "source", "sourceVersion", "confidence"],
      "properties": {
        "jmdictSeq": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "kanji": {
          "type": "array",
          "minItems": 0,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "readings": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sense": {
          "type": "integer",
          "minimum": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "const": "approved"
        },
        "source": { "type": "string", "minLength": 1 },
        "sourceVersion": { "type": "string", "minLength": 1 },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}