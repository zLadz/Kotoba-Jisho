{
  "name": "kotoba",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma de dicionário japonês multilíngue, inicialmente focada em Japonês → Português Brasileiro (pt-BR)",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev:api": "npm run dev --workspace=@kotoba/api",
    "dev:web": "npm run dev --workspace=@kotoba/web",
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "db:generate": "npm run db:generate --workspace=@kotoba/database",
    "db:migrate": "npm run db:migrate --workspace=@kotoba/database",
    "db:seed": "npm run db:seed --workspace=@kotoba/database",
    "import:jmdict": "npm run import --workspace=@kotoba/importer --",
    "benchmark:search": "npm run benchmark:search --workspace=@kotoba/api",
    "format:check": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "concurrently": "^9.0.0",
    "eslint": "^10.0.0",
    "globals": "^17.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.4"
    }
  }
}
