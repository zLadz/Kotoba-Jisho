{
  "name": "kotoba",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "kotoba",
      "version": "0.1.0",
      "workspaces": [
        "apps/*",
        "packages/*",
        "services/*"
      ],
      "engines": {
        "node": ">=20"
      }
    },
    "apps/api": {
      "name": "@kotoba/api",
      "version": "0.1.0"
    },
    "apps/web": {
      "name": "@kotoba/web",
      "version": "0.1.0"
    },
    "node_modules/@kotoba/api": {
      "resolved": "apps/api",
      "link": true
    },
    "node_modules/@kotoba/config": {
      "resolved": "packages/config",
      "link": true
    },
    "node_modules/@kotoba/database": {
      "resolved": "packages/database",
      "link": true
    },
    "node_modules/@kotoba/importer": {
      "resolved": "services/importer",
      "link": true
    },
    "node_modules/@kotoba/types": {
      "resolved": "packages/types",
      "link": true
    },
    "node_modules/@kotoba/validation": {
      "resolved": "packages/validation",
      "link": true
    },
    "node_modules/@kotoba/web": {
      "resolved": "apps/web",
      "link": true
    },
    "packages/config": {
      "name": "@kotoba/config",
      "version": "0.1.0"
    },
    "packages/database": {
      "name": "@kotoba/database",
      "version": "0.1.0"
    },
    "packages/types": {
      "name": "@kotoba/types",
      "version": "0.1.0"
    },
    "packages/validation": {
      "name": "@kotoba/validation",
      "version": "0.1.0"
    },
    "services/importer": {
      "name": "@kotoba/importer",
      "version": "0.1.0"
    }
  }
}
